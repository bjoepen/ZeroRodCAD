{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroRodCAD",
  "version": "0.1.0",
  "identifier": "de.zerorodcad.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZeroRodCAD Desktop",
        "width": 1000,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "resources/zerorod-engine-onedir/": "zerorod-engine-onedir/"
    },
    "macOS": {
      "minimumSystemVersion": "26.0"
    }
  }
}
